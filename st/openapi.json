  "components": {
    "schemas": {
      "DockRequest": {
        "properties": {
          "pdb_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pdb Id"
          },
          "receptor_pdb_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receptor Pdb Text"
          },
          "receptor_name": {
            "type": "string",
            "title": "Receptor Name",
            "default": "receptor"
          },
          "ligands": {
            "items": {
              "$ref": "#/components/schemas/LigandInput"
            },
            "type": "array",
            "title": "Ligands"
          },
          "grid": {
            "$ref": "#/components/schemas/GridBox"
          },
          "center_mode": {
            "type": "string",
            "enum": [
              "auto",
              "manual",
              "selection",
              "blind"
            ],
            "title": "Center Mode",
            "default": "auto"
          },
          "prody_sel": {
            "type": "string",
            "title": "Prody Sel",
            "default": ""
          },
          "preferred_ligand": {
            "type": "string",
            "title": "Preferred Ligand",
            "default": ""
          },
          "hetatm_policy": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Hetatm Policy"
          },
          "reference_hetatm_key": {
            "type": "string",
            "title": "Reference Hetatm Key",
            "default": ""
          },
          "ph": {
            "type": "number",
            "title": "Ph",
            "default": 7.4
          },
          "protonation_mode": {
            "type": "string",
            "enum": [
              "pkanet",
              "neutral",
              "dimorphite"
            ],
            "title": "Protonation Mode",
            "default": "pkanet"
          },
          "use_pubchem": {
            "type": "boolean",
            "title": "Use Pubchem",
            "default": true
          },
          "max_tautomers": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Max Tautomers",
            "default": 8
          },
          "ph_window": {
            "type": "number",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Ph Window",
            "default": 1.0
          },
          "pkanet_selection_mode": {
            "type": "string",
            "enum": [
              "auto_recommended",
              "highest_score",
              "manual_rank"
            ],
            "title": "Pkanet Selection Mode",
            "default": "auto_recommended"
          },
          "pkanet_manual_rank": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Pkanet Manual Rank"
          },
          "exhaustiveness": {
            "type": "integer",
            "maximum": 128.0,
            "minimum": 1.0,
            "title": "Exhaustiveness",
            "default": 8
          },
          "num_modes": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Num Modes",
            "default": 10
          },
          "energy_range": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Energy Range",
            "default": 3
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "conformer_seed": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Conformer Seed"
          },
          "fix_bond_orders": {
            "type": "boolean",
            "title": "Fix Bond Orders",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "ligands"
        ],
        "title": "DockRequest"
      },
      "DockSubmitResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          },
          "download_url": {
            "type": "string",
            "title": "Download Url"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "message",
          "status_url",
          "download_url"
        ],
        "title": "DockSubmitResponse"
      },
      "GridBox": {
        "properties": {
          "center_x": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Center X"
          },
          "center_y": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Center Y"
          },
          "center_z": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Center Z"
          },
          "size_x": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Size X",
            "default": 20.0
          },
          "size_y": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Size Y",
            "default": 20.0
          },
          "size_z": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Size Z",
            "default": 20.0
          }
        },
        "type": "object",
        "title": "GridBox"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LigandInput": {
        "properties": {
          "smiles": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Smiles"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "default": "ligand"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "description": "Ligand filename ending in .pdb, .sdf, .mol2, or .pdbqt; never a server path"
          },
          "file_content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Content",
            "description": "Exact structure-file text; JSON escapes preserve newlines"
          },
          "file_content_base64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Content Base64",
            "description": "Base64 of original file bytes, recommended for exact PDBQT provenance"
          },
          "no_add_h": {
            "type": "boolean",
            "title": "No Add H",
            "description": "For PDB: add no H and preserve existing H; direct PDBQT always bypasses preparation",
            "default": false
          }
        },
        "type": "object",
        "title": "LigandInput"
      },
      "ScanRequest": {
        "properties": {
          "pdb_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pdb Id"
          },
          "receptor_pdb_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receptor Pdb Text"
          }
        },
        "type": "object",
        "title": "ScanRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
